    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ak960/ontologies/2025/4/monstor_v5#Job_110408427">
        <rdf:type rdf:resource="http://www.semanticweb.org/ak960/ontologies/2025/4/monstor_v5#Job_Posting"/>
