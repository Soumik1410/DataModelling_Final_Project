        <naukri-version-1:Jobs_Max_Experience_Years rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</naukri-version-1:Jobs_Max_Experience_Years>
        <naukri-version-1:Jobs_Max_Salary rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1100000</naukri-version-1:Jobs_Max_Salary>
